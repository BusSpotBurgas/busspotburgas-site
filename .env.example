# Копирай този файл като .env.local и попълни стойностите.
# .env.local НЕ влиза в git (виж .gitignore).
# Взимат се от Supabase → Project Settings → API Keys / Data API.

# Публични (безопасни за браузъра, защитата е от RLS):
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Cloudflare Turnstile – публичен Site Key (Secret Key-ът отива САМО в Supabase):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Тайни (само сървър) – НИКОГА с префикс NEXT_PUBLIC_:
# Supabase → Project Settings → API Keys → Secret keys (за изтриване на профил)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Cloudflare Web Analytics (публичен код от Cloudflare → Web Analytics), по желание
NEXT_PUBLIC_CF_BEACON_TOKEN=
